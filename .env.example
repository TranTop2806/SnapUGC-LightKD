# Copy to .env and set the API key. The launchers automatically load .env.
# Keep this file shell-compatible: one KEY=value assignment per line.

# Force the hosted OpenAI-compatible API instead of the local Qwen backend.
SNAPUGC_LLM_BACKEND=openai
OPENAI_API_KEY=
SNAPUGC_LLM_BASE_URL=https://api.openai.com/v1
SNAPUGC_LLM_MODEL=gpt-4o-mini
SNAPUGC_LLM_TIMEOUT=45

# Optional demo server settings.
SNAPUGC_DEMO_HOST=127.0.0.1
SNAPUGC_DEMO_PORT=7861
